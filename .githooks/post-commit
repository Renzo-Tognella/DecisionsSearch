#!/bin/sh

# Hook versionado e fail-open. O trabalho pesado roda em background para que
# uma falha do LLM, gh, Qdrant ou Neo4j nunca impeça o commit local.
set +e

repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$repo_root" ]; then
  exit 0
fi

if [ -n "${DECISIONSSEARCH_PYTHON:-}" ]; then
  python_bin="$DECISIONSSEARCH_PYTHON"
elif [ -x "$repo_root/.venv/bin/python" ]; then
  python_bin="$repo_root/.venv/bin/python"
else
  python_bin="python3"
fi
log_dir=${DECISIONSSEARCH_COMMIT_MEMORY_LOG_DIR:-"$repo_root/.decisionssearch"}
mkdir -p "$log_dir" 2>/dev/null
log_file="$log_dir/post-commit-memory.log"

if [ "${DECISIONSSEARCH_COMMIT_MEMORY_HOOK_SYNC:-0}" = "1" ]; then
  "$python_bin" -m scripts.post_commit_memory_hook --repo "$repo_root" >>"$log_file" 2>&1
  exit 0
fi

nohup "$python_bin" -m scripts.post_commit_memory_hook --repo "$repo_root" \
  >>"$log_file" 2>&1 </dev/null &
exit 0
