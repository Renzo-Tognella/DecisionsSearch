# ── LLM Provider ──────────────────────────────────────────────
# Options: local | openai | zai | openrouter | gemini
LLM_PROVIDER=local

# Single key for all providers (or use provider-specific vars below)
LLM_API_KEY=

# Provider-specific keys (take priority over LLM_API_KEY)
OPENAI_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ── Canonical memory backend ─────────────────────────────────
# The production container uses Neo4j by default. `memory` is only for tests
# and explicit local regressions; it must not be treated as authoritative.
DECISIONSSEARCH_LEDGER_BACKEND=neo4j
DECISIONSSEARCH_ENABLE_OPERATOR_TOOLS=false

# ── Post-commit memory hook ─────────────────────────────────
# The hook is fail-open and runs asynchronously by default.
# Optional project partition override. When omitted, the server uses the Git
# repository root folder name (or the current folder for non-Git workspaces).
# DECISIONSSEARCH_PROJECT=
# DECISIONSSEARCH_SESSION_FILE=.decisionssearch/session.md
# DECISIONSSEARCH_SESSION_ID=
# DECISIONSSEARCH_PYTHON=python3
# DECISIONSSEARCH_COMMIT_MEMORY_HOOK_SYNC=0
# DECISIONSSEARCH_COMMIT_MEMORY_LOG_DIR=.decisionssearch
# DECISIONSSEARCH_COMMIT_MEMORY_STATE_PATH=.decisionssearch/commit-memory-state.jsonl

# Override base URL (auto-set per provider, but can override)
# LLM_BASE_URL=

# Chat model (auto-set per provider, but can override)
# LLM_CHAT_MODEL=

# Embedding model (auto-set per provider, but can override)
EMBEDDING_MODEL=

# Embedding dimensions (auto-set per provider, but can override)
EMBEDDING_DIMENSIONS=

# Optional: use a different provider/key for embeddings than for chat.
# Empty EMBEDDING_PROVIDER inherits LLM_PROVIDER. Example: openrouter.
EMBEDDING_PROVIDER=
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
OPENROUTER_EMBEDDING_ZDR=true
# By default EMBEDDING_DIMENSIONS is sent to compatible APIs. Set 0 only for
# a model that does not support output-dimension truncation; its native output
# dimension must still equal EMBEDDING_DIMENSIONS/Qdrant's collection dimension.
# EMBEDDING_REQUEST_DIMENSIONS=

# Optional OpenRouter attribution headers. They are sent only when the active
# chat or embedding provider is OpenRouter.
# OPENROUTER_HTTP_REFERER=https://decisionssearch.example
# OPENROUTER_APP_TITLE=DecisionsSearch

# ── Gemini-specific ──────────────────────────────────────────
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_TASK=RETRIEVAL_DOCUMENT

# ── Local fallback ───────────────────────────────────────────
# all-MiniLM-L6-v2 (384d) is English-centric — weak semantic quality for
# non-English content. If your memories are mostly in another language
# (e.g. Portuguese), use BAAI/bge-m3 (1024d, multilingual, no query
# instruction needed) instead. IMPORTANT: changing model/dimensions after
# the Qdrant collection already exists requires recreating the collection
# and re-embedding through your deployment/reindexing process.
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
LOCAL_EMBEDDING_DIMENSIONS=384
# Only needed for asymmetric models (bge-*-v1.5, e5) that require a query-side
# instruction prefix. Leave empty for bge-m3 or symmetric models like MiniLM.
LOCAL_QUERY_INSTRUCTION=

# ── Infrastructure ───────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=memories

# ── Dense + BM25/sparse retrieval ────────────────────────────
# Disabled by default so an existing dense-only collection is never changed
# silently. For a fresh install set this to true BEFORE bootstrap. For an
# existing installation, provision a new sparse-enabled collection, reindex the
# memories, validate it, and then point QDRANT_COLLECTION to the target.
SPARSE_SEARCH_ENABLED=false
SPARSE_VECTOR_NAME=bm25
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
SPARSE_INDEX_ON_DISK=false
# Weight of lexical results in application-level RRF (tune against the gold set).
RRF_SPARSE_WEIGHT=1.0

# ── Reranker ─────────────────────────────────────────────────
# Options: none | local | cohere | jina | openrouter | openai
RERANKER_PROVIDER=openrouter
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# COHERE_API_KEY=
# JINA_API_KEY=
# Uses POST /api/v1/rerank with OPENROUTER_API_KEY (not a generic chat call).
OPENROUTER_RERANK_MODEL=qwen/qwen3-reranker-8b
OPENROUTER_RERANK_ZDR=true
OPENROUTER_RERANK_BASE_URL=https://openrouter.ai/api/v1
# OpenAI uses a structured chat call as a listwise reranker (there is no
# native OpenAI rerank endpoint in this integration).
# OPENAI_RERANK_MODEL=gpt-4o-mini
# OPENAI_RERANK_BASE_URL=https://api.openai.com/v1

# ── HyDE ─────────────────────────────────────────────────────
HYDE_MIN_QUERY_LENGTH=15
# HYDE_MODEL=

# ── Extraction ───────────────────────────────────────────────
# EXTRACTION_MODEL=
